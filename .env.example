DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CoinGecko works without a key (rate limited). Optional free "Demo" key from coingecko.com
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Coins always tracked (CoinGecko ids), and refresh interval in seconds
DEFAULT_COINS=bitcoin,ethereum,solana,ripple,cardano,dogecoin
DEFAULT_VS_CURRENCY=usd
POLL_INTERVAL=30
# How long (seconds) to serve cached prices before re-fetching
PRICE_CACHE_TTL=15

# Optional PostgreSQL / Neon connection string (leave empty to use SQLite)
DATABASE_URL=
DB_NAME=
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# SMTP email configuration (console backend prints messages during local development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For real email delivery, switch to django.core.mail.backends.smtp.EmailBackend and set your SMTP host/user/password.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=CryptoTracker <no-reply@example.com>
PASSWORD_RESET_CODE_MINUTES=10


# Paystack NGN wallet rails. Keep live processing OFF until the Paystack business is approved.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYMENTS_ENABLED=0

# Luno live order execution remains disabled pending a customer-level custody design.

# Dedicated NGN virtual accounts: all flags remain OFF until registered-business approval.
BUSINESS_REGISTERED=0
PAYSTACK_DVA_ENABLED=0
# Optional DVA sandbox only: requires a Paystack sk_test_ key; forces test-bank.
PAYSTACK_DVA_TEST_MODE=0
# Keep 1 for financial-services customer validation until Paystack confirms the exact flow.
PAYSTACK_DVA_VALIDATION_REQUIRED=1
PAYSTACK_DVA_PREFERRED_BANK=test-bank

# USD card + international bank-transfer provider is intentionally not selected yet.
# Paystack's published policy excludes cryptocurrency and mobile-wallet businesses from international payments.
USD_PAYMENTS_PROVIDER=
USD_PAYMENTS_ENABLED=0

# Luno business trading and customer custody remain disabled.
LUNO_API_KEY_ID=
LUNO_API_KEY_SECRET=
LUNO_BUSINESS_APPROVED=0
LUNO_TRADING_ENABLED=0
