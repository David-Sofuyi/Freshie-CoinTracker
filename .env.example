DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CoinGecko works without a key (rate limited). Optional free "Demo" key from coingecko.com
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Coins always tracked (CoinGecko ids), and refresh interval in seconds
DEFAULT_COINS=bitcoin,ethereum,solana,ripple,cardano,dogecoin
DEFAULT_VS_CURRENCY=usd
POLL_INTERVAL=30
# How long (seconds) to serve cached prices before re-fetching
PRICE_CACHE_TTL=15

# Optional PostgreSQL (leave DB_NAME empty to use SQLite)
DB_NAME=
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

